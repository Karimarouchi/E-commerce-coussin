# ══════════════════════════════════════════════════════════════
# Front Office Environment Variables
# Copy this file to .env (local) or .env.production (server)
# Variables must start with VITE_ to be exposed to the app
# The site entry page is always "/" → Home
# ══════════════════════════════════════════════════════════════

# Local
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Production example (replace with your server API URL)
VITE_API_BASE_URL=https://api.votredomaine.com/api/v1
